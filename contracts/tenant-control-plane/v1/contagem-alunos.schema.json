{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sysbelt.com.br/contracts/tenant-control-plane/v1/contagem-alunos.schema.json",
  "title": "Snapshot agregado de alunos ativos",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "eventoId", "tenantKey", "dataCorte", "unidades"],
  "properties": {
    "versao": { "const": 1 },
    "eventoId": { "type": "string", "format": "uuid" },
    "tenantKey": { "type": "string", "format": "uuid" },
    "dataCorte": { "type": "string", "format": "date-time" },
    "unidades": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unidadeId", "nomeExibicao", "status", "alunosAtivos"],
        "properties": {
          "unidadeId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "nomeExibicao": { "type": "string", "minLength": 1, "maxLength": 200 },
          "status": { "enum": ["ATIVA", "ENCERRADA"] },
          "alunosAtivos": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
