# Banco exclusivo do sistema B2B. Nunca use aqui o banco de uma academia.
CONTROL_PLANE_DATABASE_URL="postgresql://usuario:senha@host/control_plane?sslmode=require"
CONTROL_PLANE_JWT_SECRET="gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
CONTROL_PLANE_WORKER_SECRET="gere-outro-segredo-aleatorio-com-pelo-menos-32-caracteres"
# Permanece false até os adaptadores Neon e cofre estarem configurados.
PROVISIONAMENTO_REAL_HABILITADO="false"
AWS_REGION="sa-east-1"
# Opcional, porém recomendado em produção: chave KMS gerenciada pelo SysBelt.
AWS_SECRETS_KMS_KEY_ID=""
AWS_SECRETS_PREFIX="sysbelt/prod/tenants"
# Usadas somente pelo comando npm run seed:operator.
CONTROL_PLANE_ADMIN_NAME="Administrador SysBelt"
CONTROL_PLANE_ADMIN_EMAIL="admin@sysbelt.com.br"
CONTROL_PLANE_ADMIN_PASSWORD="troque-por-uma-senha-forte"
PORT=3334
