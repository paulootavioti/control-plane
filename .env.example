# Banco exclusivo do sistema B2B. Nunca use aqui o banco de uma academia.
CONTROL_PLANE_DATABASE_URL="postgresql://usuario:senha@host/control_plane?sslmode=require"
CONTROL_PLANE_JWT_SECRET="gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
CONTROL_PLANE_WORKER_SECRET="gere-outro-segredo-aleatorio-com-pelo-menos-32-caracteres"
# Autentica exclusivamente a consulta backend-backend do diretório de tenants.
CONTROL_PLANE_DIRECTORY_SECRET="gere-um-terceiro-segredo-aleatorio-com-pelo-menos-32-caracteres"
# Credenciais separadas e rotacionáveis por produto. JSON em uma única linha.
CONTROL_PLANE_PRODUCT_CREDENTIALS='{"sysbelt":{"v1":"gere-32+-caracteres"},"mecanix":{"v1":"gere-outros-32+-caracteres"},"psyche":{"v1":"gere-outros-32+-caracteres"}}'
# Compatibilidade temporária. Habilite somente enquanto o SysBelt ainda usar o header legado.
CONTROL_PLANE_DIRECTORY_LEGACY_ENABLED="false"
CONTROL_PLANE_DIRECTORY_LEGACY_SUNSET=""
# Chave privada Ed25519 exclusiva para assinar concessões aos tenants.
CONTROL_PLANE_GRANT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# Domínio compartilhado pelos tenants. Ex.: academia-x.app.sysbelt.com.br.
TENANT_APP_BASE_DOMAIN="app.sysbelt.com.br"
# Permanece false até os adaptadores Neon e cofre estarem configurados.
PROVISIONAMENTO_REAL_HABILITADO="false"
# Eventos por chamada do worker (1 a 10; padrão 3).
CONTROL_PLANE_WORKER_BATCH_SIZE="3"
AWS_REGION="sa-east-1"
# Opcional, porém recomendado em produção: chave KMS gerenciada pelo SysBelt.
AWS_SECRETS_KMS_KEY_ID=""
AWS_SECRETS_PREFIX="sysbelt/prod/tenants"
NEON_API_KEY="configure-como-segredo"
NEON_ORG_ID=""
NEON_REGION_ID="aws-sa-east-1"
# Serviço isolado que aplica migrations/bootstrap/health usando apenas a
# referência do segredo; connection strings não trafegam pelo Control Plane.
TENANT_PROVISIONER_URL="https://provisionador-interno.example.com"
TENANT_PROVISIONER_TOKEN="gere-um-token-interno-com-pelo-menos-32-caracteres"
# Usadas somente pelo comando npm run seed:operator.
CONTROL_PLANE_ADMIN_NAME="Administrador SysBelt"
CONTROL_PLANE_ADMIN_EMAIL="admin@sysbelt.com.br"
CONTROL_PLANE_ADMIN_PASSWORD="troque-por-uma-senha-forte"
PORT=3334

# Billing Mercado Pago. Deixe vazio até as credenciais de produção serem
# emitidas após o lançamento. Nunca use token de produção em arquivo local.
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_BACK_URL="https://sysbelt-control-plane.netlify.app/billing/retorno"
MERCADO_PAGO_WEBHOOK_URL="https://sysbelt-control-plane.netlify.app/api/billing/webhooks/mercado-pago"
# Somente homologação local; mantenha false em produção.
BILLING_TEST_EVENTS_ENABLED="false"
BILLING_WORKER_ENABLED="false"
BILLING_WORKER_BATCH_SIZE="10"
# Entrega da outbox. Permaneça false até homologar o serviço receptor.
BILLING_NOTIFICATION_DELIVERY_ENABLED="false"
BILLING_NOTIFICATION_WEBHOOK_URL="https://notificacoes.example.com/control-plane/billing"
BILLING_NOTIFICATION_WEBHOOK_TOKEN="gere-um-token-exclusivo-com-pelo-menos-32-caracteres"
